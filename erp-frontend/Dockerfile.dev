# Dev-only image: local docker-compose stack (PLAN.md step 0.14), not a
# production build. Hot-reloads via `next dev --turbopack` with the source
# bind-mounted from the host (see docker-compose.yml).
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
