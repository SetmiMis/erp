# erp-backend environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- App ---
NODE_ENV=development
# NestJS listens on this port (see src/main.ts); defaults to 3001 if unset.
# Global API prefix is always /api.
# PORT=3001

# Comma-separated list of allowed frontend origins for CORS. Unset, defaults
# to http://localhost:3000 (Next.js' default dev port) only. Set this
# explicitly in every non-local environment.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Database ---
# Preferred: a full connection string (Supabase Postgres or any Postgres instance)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Set to "true" when connecting to Supabase or any provider that requires SSL
DB_SSL=true
# Every migration in src/migrations/*.ts is schema-qualified to "erp_test"
# (see PLAN.md step 0.16) -- this must be set to that for migrations to find
# their tables, on Supabase or anywhere else.
DB_SCHEMA=erp_test

# --- Supabase dev/staging project ---
# Project: erp-manufacturing-dev (ap-south-1), created for this project's
# Phase 0/1 work. Get the DB password from the Supabase dashboard --
# Project Settings > Database > Connection string (or reset it there if
# it's been lost; nobody should be pasting it into a committed file, this
# one included).
#
# Use the SESSION POOLER host, not the direct db.<ref>.supabase.co host:
#   DATABASE_URL=postgresql://postgres.pqmgtrytjfknooangpho:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#   DB_SSL=true
#   DB_SCHEMA=erp_test
# Why: db.<ref>.supabase.co now resolves to an IPv6 address. Render (and any
# host without IPv6 egress) fails with ECONNREFUSED/ENETUNREACH connecting to
# it -- confirmed live deploying erp-backend there. The pooler host resolves
# to IPv4 and works everywhere; use it by default rather than hitting this
# again on the next host. Note the username changes too: postgres.<project-ref>,
# not just postgres.
#
# The schema + all 6 migrations are already applied there (via the Supabase
# MCP tools, not `npm run migration:run` -- this sandbox has no network path
# to *.supabase.co, only to the Supabase management API). A real machine with
# normal internet access can run `npm run migration:run` against it too;
# TypeORM will see all 6 already recorded in erp_test.migrations and no-op.

# Alternative: discrete Postgres connection vars, used only if DATABASE_URL is not set
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=erp

# Local/offline fallback (no external DB needed) — set DB_TYPE=sqlite to use this instead
# DB_TYPE=sqlite
# DB_DATABASE=data/sqlite.db

# --- Auth ---
# Required. Use a long random string in every real environment.
JWT_SECRET=replace-with-a-long-random-secret
# Access/refresh token lifetimes, as jsonwebtoken "zeit/ms"-style strings
# (e.g. "15m", "1h", "7d"). Both default to the values below if unset.
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
